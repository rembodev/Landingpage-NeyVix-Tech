# ==============================================================================
# NEYVIX TECH - VARIABLES DE ENTORNO DE MUESTRA (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env' para desarrollo local:
#    cp .env.example .env
# 2. Reemplaza los valores con las credenciales de tu proyecto de Supabase.
#    (Supabase Dashboard -> Project Settings -> API)
# 3. NUNCA comitees tu archivo '.env' real a Git.
# 4. Para producción en Netlify:
#    Configura estas mismas variables en Site Configuration -> Environment Variables.
# ==============================================================================

# URL de la instancia de Supabase (Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (Project API Key: anon / public)
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-de-supabase
